# Barbacane image version to pull from ghcr.io/barbacane-dev
# The playground needs 1.0.0-rc.2 or later. `latest` is the most recent stable
# release, which release candidates do not move.
BARBACANE_VERSION=1.0.0-rc.2

# Admin token for the control plane, at least 32 bytes: the control plane
# refuses to start without one. This is a demo default: change it for any
# non-local use.
BARBACANE_CONTROL_ADMIN_TOKEN=playground-admin-token-change-me-0123456789
